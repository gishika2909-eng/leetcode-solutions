class Solution {
public:
    double findMedianSortedArrays(vector<int>& nums1, vector<int>& nums2) {
        int m = nums1.size();
        int n = nums2.size();

        vector<int> a(m + n);

        int i = 0, j = 0, k = 0;

        // Merge the two sorted arrays
        while (i < m && j < n) {
            if (nums1[i] < nums2[j]) {
                a[k++] = nums1[i++];
            } else {
                a[k++] = nums2[j++];
            }
        }

        while (i < m) {
            a[k++] = nums1[i++];
        }

        while (j < n) {
            a[k++] = nums2[j++];
        }

        int total = m + n;

        if (total % 2 == 1) {
            return a[total / 2];
        } else {
            return (a[total / 2] + a[total / 2 - 1]) / 2.0;
        }
    }
};
