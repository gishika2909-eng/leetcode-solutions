class Solution {
public:
    void nextPermutation(vector<int>& a) {
        int p=-1,n=a.size();
        for (int i=n-2;i>=0;i--){
            if(a[i]<a[i+1]){
                p=i;
                break;
            }
        }
        if(p==-1){
            reverse(a.begin(),a.end());
            return;
        }
        for(int i =n-1;i>p;i--){
            if(a[i]>a[p]){
                swap(a[i],a[p]);
                break;
            }
        }
        int i=p+1,j=n-1;
        while(i<=j){
            swap(a[i++],a[j--]);
        }

    }
};
